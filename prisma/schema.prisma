generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ... your models (User, Account, Transaction) stay exactly the same

// --- DATABASE TABLES ---

model User {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  creditScore    Int
  snapshotAmount Float
  
  // A user can have multiple accounts
  accounts       Account[] 
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accountKey  String   // e.g., "checking", "freedomUnlimited" (Helps our UI map easily)
  name        String
  mask        String
  routing     String?  // Optional: Credit cards don't have routing numbers
  accountNum  String?  // Optional: Credit cards don't use this the same way
  
  balance     Float
  creditLimit Float?   // Optional: Bank accounts don't have this
  paymentDue  Float?   // Optional: Bank accounts don't have this
  
  // An account can have multiple transactions
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  date        String   // Storing as String (e.g., "Today", "Yesterday") to match your exact UI prototype
  desc        String
  cat         String
  amount      Float
  
  createdAt   DateTime @default(now()) // Real database timestamp for sorting
}