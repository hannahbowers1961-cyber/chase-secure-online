generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENTERPRISE DATABASE TABLES ---

model User {
  id          String    @id @default(cuid())
  username    String    @unique // NEW: Unique login ID
  password    String    // NEW: Will store the hashed password
  firstName   String
  lastName    String
  creditScore Int
  
  accounts    Account[] 
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accountKey  String   
  name        String
  mask        String
  type        String   // "DEPOSITORY" (Checking/Savings) or "CREDIT" (Cards/Loans)
  
  // Depository-specific fields
  routing     String?  
  accountNum  String?  
  
  // Credit-specific fields
  creditLimit Float?   
  
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  date        DateTime // Strict Database Timestamp
  desc        String
  cat         String
  amount      Float    // Credits = positive, Debits = negative
  
  createdAt   DateTime @default(now()) 
}